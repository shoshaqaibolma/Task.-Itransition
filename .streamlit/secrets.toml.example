# Copy to .streamlit/secrets.toml for local runs (never commit the real file).
# On Streamlit Cloud paste the same lines into: App settings -> Secrets.

# Default: Google Gemini, free tier. Create a key at https://aistudio.google.com/apikey
LLM_PROVIDER = "gemini"
LLM_API_KEY = "your-gemini-key"
LLM_MODEL = "gemini-3.8-flash"

# Alternatives:
# LLM_PROVIDER = "anthropic"   # Claude, paid; LLM_MODEL = "claude-sonnet-5-5"
# LLM_PROVIDER = "openai"      # any OpenAI-compatible API; set LLM_MODEL and LLM_BASE_URL
